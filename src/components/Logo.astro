---
import { brand } from '../data/site';
interface Props { tone?: 'dark' | 'light' }
const { tone = 'dark' } = Astro.props;
---
<a href="#beranda" class:list={['logo', `logo--${tone}`]} aria-label={`${brand.name} — kembali ke beranda`}>
  <svg class="logo__mark" viewBox="0 0 44 44" aria-hidden="true">
    <circle cx="22" cy="22" r="21" fill="currentColor" />
    <path d="M13 25.5c0-5 4-8.5 9-8.5s9 3.5 9 8.5c0 1.4-1.1 2.5-2.5 2.5h-13A2.5 2.5 0 0 1 13 25.5z" fill="none" stroke="var(--logo-ink)" stroke-width="1.6" />
    <path d="M17.5 18.6c.6 2 .6 4.5 0 7.4M22 17v9M26.5 18.6c-.6 2-.6 4.5 0 7.4" fill="none" stroke="var(--logo-ink)" stroke-width="1.4" stroke-linecap="round" />
    <path d="M22 14.2c-.9-1.3-2.9-.8-2.9.7 0 1.3 2.9 2.6 2.9 2.6s2.9-1.3 2.9-2.6c0-1.5-2-2-2.9-.7z" fill="var(--logo-accent)" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">Dapur <em>Manis</em></span>
    <span class="logo__tag">{brand.tagline}</span>
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: .65rem; color: var(--chocolate); --logo-ink: var(--ivory); --logo-accent: #e4a870; }
  .logo--light { color: var(--ivory); --logo-ink: var(--chocolate); --logo-accent: var(--caramel); }
  .logo__mark { width: 40px; height: 40px; flex: none; }
  .logo__text { display: flex; flex-direction: column; line-height: 1; }
  .logo__name { font-family: var(--font-serif); font-size: 1.32rem; font-weight: 500; letter-spacing: -.01em; }
  .logo__name em { font-style: italic; font-weight: 400; color: var(--caramel-deep); }
  .logo--light .logo__name em { color: #e4b98c; }
  .logo__tag { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; opacity: .65; margin-top: .3rem; }
</style>
